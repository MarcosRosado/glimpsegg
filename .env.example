# Copie para .env e preencha. O .env NUNCA deve ser commitado (.gitignore cobre .env*).
#
# Token da API STRATZ. Opcional: sem ele o app abre no dataset de demonstração.
# Obtenha em https://stratz.com/api
#
# ATENÇÃO: o token pessoal da STRATZ não pode ser revogado. Se ele vazar, fica
# válido até a data de expiração. Não commite, não cole em issues, não poste em prints.
STRATZ_API_KEY=

# Steam Account ID (32 bits) padrão a carregar na inicialização. Opcional:
# o app extrai automaticamente do claim "SteamId" do próprio token.
DEFAULT_STEAM_ACCOUNT_ID=
