# Copie para .env se precisar. O .env NUNCA deve ser commitado (.gitignore cobre .env*).
#
# O APP NAO USA TOKEN NENHUM: desde 2026-11-19 ele fala so com a OpenDota, que é publica.
#
# Steam Account ID (32 bits) padrao a carregar na inicializacao do Electron. Opcional:
# sem ele o app abre o onboarding e pede a conta.
DEFAULT_STEAM_ACCOUNT_ID=

# So para os scripts de medicao de scripts/ (docs/COLETA-GABARITO.md), que ainda consultam a
# STRATZ como gabarito. O app nao le esta variavel para nada.
#
# ATENCAO: o token pessoal da STRATZ nao pode ser revogado. Se ele vazar, fica valido ate a
# data de expiracao. Nao commite, nao cole em issues, nao poste em prints.
STRATZ_API_KEY=
